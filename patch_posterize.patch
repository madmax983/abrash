     let levels = config.levels.max(2.0); // Minimum of 2 levels
     let levels_minus_1 = levels - 1.0;

+    // ⚡ Bolt: Cache LUT for expensive floating point operations in hot loop
+    let mut lut = [0u32; 256];
+    let factor_1 = levels_minus_1 / 255.0;
+    let factor_2 = 255.0 / levels_minus_1;
+    for (i, val) in lut.iter_mut().enumerate() {
+        let v = i as f32;
+        let new_v = ((v * factor_1).round() * factor_2) as u32;
+        *val = new_v.min(255);
+    }
+
